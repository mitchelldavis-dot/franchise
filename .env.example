# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=FranchiseRadar/0.1.0

# YouTube API (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: Twitter/X API (if using official API)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# Optional: Meta/Facebook Graph API
META_ACCESS_TOKEN=

# Database
DATABASE_URL=sqlite:///./data/franchise_radar.db

# Application settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DEMO_MODE=true

# Rate limiting (requests per minute)
REDDIT_RATE_LIMIT=60
YOUTUBE_RATE_LIMIT=100
WEB_CRAWL_RATE_LIMIT=30

# Geography settings
FLORIDA_ONLY_MODE=true
FLORIDA_LEAD_THRESHOLD=50
FLORIDA_SCORE_BOOST=5

# Scoring thresholds
MIN_BUYER_SCORE=40
MIN_OWNER_PAIN_SCORE=40
